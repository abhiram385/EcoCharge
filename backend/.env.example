PORT=4000
DATABASE_URL=postgres://ecocharge_user:ecocharge_pass@localhost:5432/ecocharge
# Defaults to true when NODE_ENV=production, false otherwise. Set explicitly
# to override (e.g. a self-hosted Postgres without SSL in production).
# DATABASE_SSL=true
# Connection pool tuning — sane defaults, override per-environment as needed.
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONN_TIMEOUT_MS=5000
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=5
# 'console' logs the OTP instead of sending SMS (dev default). Set to
# 'smsgateway' in production and fill in the SMS_GATEWAY_* vars. See utils/sms.js.
SMS_PROVIDER=console
# Required when SMS_PROVIDER=smsgateway. Runs "SMS Gateway for Android" on an
# Android phone; credentials come from the app's Cloud Server section. No DLT,
# no KYC — the SMS is sent from the phone's own SIM.
# SMS_GATEWAY_USER=replace_with_gateway_username
# SMS_GATEWAY_PASSWORD=replace_with_gateway_password
# Optional — defaults to the cloud relay. Point at the phone's LAN address for
# local mode: http://<phone-ip>:8080/3rdparty/v1
# SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
EXPOSE_OTP_IN_RESPONSE=true
# Shared key that /api/tracker/ingest requires in the x-ingest-key header.
# Used by tools/trackerFeeder.js and (later) the EL-440 GPRS decoder.
TRACKER_INGEST_KEY=replace_with_a_long_random_string
# HMAC signing key for /api/tracker/sms-hook — must match the "Signing key"
# set on the webhook in the SMS Gateway for Android app.
TRACKER_SMS_HOOK_SECRET=replace_with_a_long_random_string
# The EL-440's own SIM number, and the exact string that follows "GETGPS" in
# the command SMS (angle brackets included, if the device wants them) — used
# by tools/pollEl440.js, which sends "GETGPS" + EL440_GETGPS_PASSWORD.
EL440_DEVICE_NUMBER=+919247539013
EL440_GETGPS_PASSWORD=<device_password>
NODE_ENV=development
