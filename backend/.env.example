PORT=4000
DATABASE_URL=postgres://ecocharge_user:ecocharge_pass@localhost:5432/ecocharge
# Defaults to true when NODE_ENV=production, false otherwise. Set explicitly
# to override (e.g. a self-hosted Postgres without SSL in production).
# DATABASE_SSL=true
# Connection pool tuning — sane defaults, override per-environment as needed.
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONN_TIMEOUT_MS=5000
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=5
# 'console' logs the OTP instead of sending SMS (dev default). Set to 'twilio'
# in production and fill in the TWILIO_* vars below. See utils/sms.js.
SMS_PROVIDER=console
# Required when SMS_PROVIDER=twilio — from console.twilio.com.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
# TWILIO_FROM_NUMBER=+15005550006
EXPOSE_OTP_IN_RESPONSE=true
NODE_ENV=development
