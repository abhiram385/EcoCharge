PORT=4000
DATABASE_URL=postgres://ecocharge_user:ecocharge_pass@localhost:5432/ecocharge
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=30d
OTP_EXPIRY_MINUTES=5
